# Canonical URI of THIS server, exactly as clients will send it in the OAuth
# `resource` parameter (RFC 8707 §2). https, no fragment, no trailing slash.
MCP_RESOURCE_URL=https://mcp.example.com/mcp

# Issuer identifier of the authorization server that mints your access tokens.
# Must match the `iss` claim byte-for-byte.
MCP_AUTH_ISSUER=https://auth.example.com

# Where to fetch signing keys. Usually `jwks_uri` from the AS metadata at
# {MCP_AUTH_ISSUER}/.well-known/oauth-authorization-server
MCP_JWKS_URL=https://auth.example.com/.well-known/jwks.json

# Space-separated. Advertised as `scopes_supported` and in the 401 challenge.
# Keep this to the minimum needed for basic functionality; ask for more per
# tool via the step-up flow.
MCP_REQUIRED_SCOPES=notes:read

# Optional
MCP_ALGORITHMS=RS256
HOST=127.0.0.1
PORT=8000
